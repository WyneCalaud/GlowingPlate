[resource]
script = ExtResource("1_ns4s4")
customer_name = "Boba"
order_text = "I really love chicken and pumpkin. You can choose the rest of the meal for me, as long as it’s healthy. Hot water please, and milk is fine."
expanded_text = "Go: Rice or Pan de sal Grow: Chicken Glow: Pumpkin + Mango Drink: Hot water + milk"
needs = {
"GlowFru": "MANGO",
"GlowVeg": "PUMPKIN",
"Go": "RICE",
"Grow": "CHICKEN_LEG"
}
beverage_needs = Array[String](["HOT_WATER", "REGULAR_MILK"])
