script = ExtResource("1_tmc27")
customer_name = "Rimo"
order_text = "I don’t really feel like eating rice or pan de sal. But my favorites are chicken, sitaw, and mango. Cold water please, and milk is fine."
expanded_text = "Go: Corn Grow: Chicken Glow: Sitaw + Mango Drink: Cold water + milk"
age = 12
needs = {
"GlowFru": "MANGO",
"GlowVeg": "SITAW",
"Go": "CORN",
"Grow": "CHICKEN_LEG"
}
